{
  "name": "mi-carrera-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API para Mi Carrera: gestión multi-carrera, autenticación y persistencia en Neon PostgreSQL",
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/db/migrate.js",
    "seed:generate": "tsx tools/generateSeedData.ts",
    "seed": "tsx src/scripts/seed.ts",
    "make-admin": "tsx src/scripts/makeAdmin.ts",
    "import:schedule": "tsx src/scripts/importScheduleDb.ts",
    "migrate:professors": "tsx src/scripts/migrateProfessors.ts",
    "merge-professors": "tsx src/scripts/mergeProfessors.ts",
    "verify-user": "tsx src/scripts/verifyUser.ts",
    "test": "tsx test/reviews.test.ts && tsx test/authVerification.test.ts",
    "test:neon": "tsx test/integration.test.ts && tsx test/reviews.test.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.5",
    "@types/pg": "^8.11.11",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.40.0",
    "express": "^4.21.2",
    "google-auth-library": "^11.3.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3",
    "typescript": "^5.7.3",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.3"
  }
}
