# ==========================================
# Variables de Entorno - Backend Mi Carrera
# ==========================================

# Base de datos PostgreSQL en Neon (conexión pooled con SSL para runtime)
DATABASE_URL=

# Base de datos PostgreSQL en Neon (conexión directa sin pooler para migraciones drizzle-kit)
DIRECT_URL=

# Secretos criptográficos para JWT (generar con openssl rand -base64 32)
JWT_SECRET=
REFRESH_SECRET=

# Origen permitido del frontend para CORS y protección CSRF (ej: http://localhost:5173 o https://tu-app.vercel.app)
CLIENT_ORIGIN=http://localhost:5173

# Puerto del servidor Express (Render inyecta PORT automáticamente)
PORT=4000

# Entorno: development | production
NODE_ENV=development

