# ==========================================
# Variables de Entorno - Backend Stack
# ==========================================

# Base de datos PostgreSQL en Neon (conexión pooled con SSL para runtime)
DATABASE_URL=

# Base de datos PostgreSQL en Neon (conexión directa sin pooler para migraciones drizzle-kit)
DIRECT_URL=

# Secretos criptográficos para JWT (generar con openssl rand -base64 32)
JWT_SECRET=
REFRESH_SECRET=

# Origen permitido del frontend para CORS y protección CSRF (ej: http://localhost:5173 o https://corre-ten.vercel.app)
CLIENT_ORIGIN=http://localhost:5173

# Puerto del servidor Express (Render inyecta PORT automáticamente)
PORT=4000

# Entorno: development | production
NODE_ENV=development

# Google Identity Services (OAuth 2.0 Web Client ID de Google Cloud Console)
# Obligatorio en producción para el inicio de sesión y registro con Google
GOOGLE_CLIENT_ID=

# Proveedor de correo electrónico para códigos de verificación (resend | brevo)
# Render Free bloquea SMTP saliente, por lo que se utiliza la API HTTP oficial
EMAIL_PROVIDER=resend

# API Key de Resend (si EMAIL_PROVIDER=resend, https://resend.com)
RESEND_API_KEY=

# API Key de Brevo (si EMAIL_PROVIDER=brevo, https://brevo.com)
BREVO_API_KEY=

# Remitente verificado en tu proveedor de email
EMAIL_FROM=Stack <noreply@stack.app>
EMAIL_FROM_NAME=Stack

# Secreto para hashear códigos de verificación con HMAC-SHA256 (min 16 caracteres)
VERIFICATION_CODE_PEPPER=dev_verification_code_pepper_secret_min_16

# ==========================================
# Almacenamiento en Cloudflare R2 (Biblioteca de Material)
# ==========================================
# Obligatorias en producción (en desarrollo/tests se simula localmente si no están configuradas)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=stack-library
# Correo público para reclamos de derechos de autor y consultas
CONTACT_EMAIL=contacto@stack.app
# Correo(s) para recibir avisos de nuevo material pendiente de moderación (separados por coma, opcional con fallback a admins)
ADMIN_NOTIFICATION_EMAIL=admin@sistemas.frc.utn.edu.ar,coord@sistemas.frc.utn.edu.ar


